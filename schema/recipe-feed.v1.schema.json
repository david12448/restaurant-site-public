{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved recipe feed for food+restaurant site v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "recipes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "recipes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recipe"
      }
    }
  },
  "$defs": {
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recipe_id",
        "dish_id",
        "title",
        "cuisine_regions",
        "origin_countries",
        "category",
        "servings",
        "prep_minutes",
        "cook_minutes",
        "difficulty",
        "ingredients",
        "steps",
        "publication_kind",
        "source_credit",
        "last_verified_at"
      ],
      "properties": {
        "recipe_id": {
          "type": "string",
          "pattern": "^rcp_[a-zA-Z0-9_-]{6,80}$"
        },
        "dish_id": {
          "type": "string",
          "pattern": "^dish_[a-zA-Z0-9_-]{5,80}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "original_name": {
          "type": "string",
          "maxLength": 140
        },
        "description": {
          "type": "string",
          "maxLength": 400
        },
        "cuisine_regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "origin_countries": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "servings": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "prep_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "cook_minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "difficulty": {
          "enum": [
            "easy",
            "medium",
            "advanced"
          ]
        },
        "ingredients": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "amount": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "unit": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "order",
              "instruction"
            ],
            "properties": {
              "order": {
                "type": "integer",
                "minimum": 1
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "publication_kind": {
          "enum": [
            "official_source",
            "adaptation",
            "broadcast_inspired",
            "editorial_original"
          ]
        },
        "source_credit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "license_verified",
            "verified_at"
          ],
          "properties": {
            "provider": {
              "type": "string",
              "minLength": 2
            },
            "license_verified": {
              "const": true
            },
            "verified_at": {
              "type": "string",
              "format": "date"
            },
            "source_country": {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            "language": {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
            }
          }
        },
        "last_verified_at": {
          "type": "string",
          "format": "date"
        },
        "associated_restaurant_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^rst_[a-zA-Z0-9_-]{6,80}$"
          }
        },
        "broadcast_mentions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "program",
              "relation",
              "verified_at"
            ],
            "properties": {
              "program": {
                "type": "string",
                "minLength": 2
              },
              "relation": {
                "enum": [
                  "featured_recipe",
                  "inspired_by",
                  "dish_appeared"
                ]
              },
              "verified_at": {
                "type": "string",
                "format": "date"
              },
              "episode": {
                "type": "string"
              }
            }
          }
        },
        "youtube_videos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "video_id",
              "title",
              "channel",
              "verified_at"
            ],
            "properties": {
              "video_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{11}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "channel": {
                "type": "string",
                "minLength": 1
              },
              "verified_at": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "food_group": {
          "type": "string",
          "enum": [
            "meal",
            "bread_baking",
            "dessert",
            "frozen_dessert",
            "beverage",
            "convenience_combo"
          ],
          "description": "Optional for backward-compatible v1 consumers. New entries must specify a group."
        },
        "food_subgroup": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70
        },
        "style_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "traditional",
              "fusion",
              "remix",
              "home_style",
              "quick_easy",
              "convenience"
            ]
          }
        },
        "preparation_methods": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "stovetop",
              "oven",
              "air_fryer",
              "microwave",
              "no_cook",
              "freezer",
              "other"
            ]
          }
        },
        "serving_unit": {
          "type": "string",
          "enum": [
            "serving",
            "piece",
            "cup",
            "batch"
          ]
        },
        "time_notes": {
          "type": "string",
          "maxLength": 300
        },
        "parent_recipe_id": {
          "type": "string",
          "pattern": "^rcp_[A-Za-z0-9_-]{6,80}$"
        },
        "combo_products": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "product_name",
              "checked_at"
            ],
            "properties": {
              "product_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 130
              },
              "brand": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "package": {
                "type": "string",
                "minLength": 1,
                "maxLength": 90
              },
              "checked_at": {
                "type": "string",
                "format": "date"
              },
              "substitution_note": {
                "type": "string",
                "maxLength": 250
              }
            }
          }
        },
        "cross_references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "source_country",
              "language",
              "relation",
              "verified_at"
            ],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1,
                "maxLength": 130
              },
              "source_country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              "language": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
              },
              "relation": {
                "enum": [
                  "comparison",
                  "inspiration",
                  "supporting"
                ]
              },
              "verified_at": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    }
  }
}
